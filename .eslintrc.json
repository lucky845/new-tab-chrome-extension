{
    "root": true,
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": ["eslint:recommended", "plugin:prettier/recommended"],
    "parserOptions": {
        "ecmaVersion": 12,
        "sourceType": "module"
    },
    "globals": {
        "chrome": "readonly",
        "Sortable": "readonly",
        "NewTabApp": "readonly",
        "AdvancedPagination": "readonly",
        "SearchManager": "readonly",
        "QuickAccessManager": "readonly",
        "WallpaperManager": "readonly",
        "SettingsManager": "readonly",
        "WeatherManager": "readonly",
        "SELECTORS": "readonly"
    },
    "rules": {
        "no-unused-vars": ["warn", { "args": "none" }],
        "no-console": "off"
    },
    "ignorePatterns": ["icons/**", "img/**", "js/components/sortable.min.js"]
}
