{
    "manifest_version": 3,
    "name": "新标签页",
    "version": "1.0.3",
    "description": "一款功能丰富、高度可定制的新标签页，提供高清壁纸、快捷网站访问和搜索功能。",
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://api.pexels.com/"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "新标签页"
    },
            "content_security_policy": {
            "extension_pages": "script-src 'self'; object-src 'self'; img-src * data:;"
        }
}